---
import { Image } from 'astro:assets';
import { getProfile } from '../profile';
import ContactLinks from './ContactLinks.astro';

const profile = await getProfile();
---

<section aria-labelledby="intro-name">
  <Image src={profile.photo} alt={profile.photoAlt} width={160} loading="eager" />
  <h1 id="intro-name">{profile.name}</h1>
  <p>{profile.headline}</p>
  <p>{profile.bio}</p>
  <ContactLinks />
  <p><a href="/resume.pdf" download>Download résumé</a></p>
</section>
