---
import Icon from './Icon.astro';
import { getSiteSections } from '../site-sections';

// The strip is the line diagram: Intro, then one stop per section that has content.
const sections = await getSiteSections();
const stops = [{ id: 'intro', label: 'Intro', href: '/#intro' }, ...sections];
const onWriting = Astro.url.pathname.startsWith('/blog');
---

<nav class="strip__inner wrap" aria-label="Sections">
  <ol class="stops">
    {
      stops.map(({ id, label, href }, index) => (
        <li class="stop" data-stop={id}>
          {index > 0 && <span class="segment" aria-hidden="true" />}
          <a href={href} aria-current={id === 'writing' && onWriting ? 'page' : undefined}>
            <span class="stop__dot" aria-hidden="true" />
            <span class="stop__name">{label}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <a class="resume" href="/resume.pdf" target="_blank">
    <span class="resume__bullet"><Icon name="download" /></span>
    <span>Résumé<span class="vh"> (PDF, opens in a new tab)</span></span>
  </a>
</nav>

<style>
  .strip__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 60px;
  }

  .stops {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .stop {
    flex: none;
    display: flex;
    align-items: center;
  }

  .segment {
    flex: none;
    width: clamp(18px, 7vw, 120px);
    height: 7px;
    margin-inline: 4px;
    background: var(--line);
  }

  .stop a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 6px;
    color: var(--paper);
    text-decoration: none;
    border-radius: 6px;
  }

  .stop a:focus-visible {
    outline-color: var(--paper);
    outline-offset: 0;
  }

  .stop__dot {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--paper);
    border: 5px solid var(--line);
    transition: background-color 0.3s var(--ease-out);
  }

  /* The stop the visitor is at fills orange. */
  .stop[data-here] .stop__dot,
  .stop a[aria-current] .stop__dot {
    background: var(--line);
    border-color: var(--line);
    box-shadow: inset 0 0 0 3px var(--ink);
  }

  .stop__name {
    font-size: 0.875rem;
    font-weight: 800;
    font-stretch: 75%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .stop a:hover .stop__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .resume {
    flex: none;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 999px;
    background: var(--track-yellow);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 800;
    font-stretch: 75%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .resume:hover {
    background: var(--paper);
  }

  .resume:focus-visible {
    outline-color: var(--paper);
  }

  .resume__bullet {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--track-yellow);
  }

  .resume__bullet :global(svg) {
    width: 15px;
    height: 15px;
  }

  @media (max-width: 559px) {
    .resume > span:last-child {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .resume {
      padding: 6px;
    }

    .stop a {
      gap: 7px;
      padding-inline: 3px;
    }

    .segment {
      width: 14px;
    }

    .stop__name {
      font-size: 0.8125rem;
      letter-spacing: 0.04em;
    }

    .stop__dot {
      width: 16px;
      height: 16px;
      border-width: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stop__dot {
      transition: none;
    }
  }
</style>
