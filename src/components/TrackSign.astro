---
// The sign that shows which Stack track is lit, with a way to clear it. Driven by src/scripts/line.ts.
---

<p id="track-hint" hidden>Lights up every stop that used it. Press Escape to clear.</p>
<div class="track-sign" data-track-sign hidden>
  <span class="track-sign__dot" aria-hidden="true"></span>
  <p class="track-sign__text" data-track-sign-text></p>
  <button type="button" class="track-sign__clear" data-track-clear>Clear</button>
</div>
<p class="vh" role="status" data-track-status></p>

<style>
  .track-sign {
    position: fixed;
    z-index: 30;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: calc(100vw - 24px);
    padding: 8px 8px 8px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 10px 28px rgb(20 20 20 / 0.28);
    translate: -50% 0;
    transition:
      opacity 0.3s var(--ease-out),
      translate 0.45s var(--ease-out),
      display 0.45s allow-discrete;
  }

  .track-sign[hidden] {
    display: none;
    opacity: 0;
    translate: -50% 16px;
  }

  @starting-style {
    .track-sign {
      opacity: 0;
      translate: -50% 16px;
    }
  }

  .track-sign__dot {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--track, var(--paper));
    box-shadow: inset 0 0 0 3px var(--paper);
  }

  .track-sign__text {
    font-weight: 800;
    font-stretch: 87.5%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-sign__clear {
    flex: none;
    min-height: 36px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 800;
    font-stretch: 87.5%;
    cursor: pointer;
  }

  .track-sign__clear:hover {
    background: var(--track-yellow);
  }

  .track-sign__clear:focus-visible {
    outline-color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .track-sign {
      transition: none;
    }
  }
</style>
