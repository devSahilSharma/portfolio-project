---
import { trackColour, trackKey } from '../stack-tracks';

// A Stack as interchange bullets. Each is a toggle that lights every stop on that track
// (see src/scripts/line.ts); without JS they are simply the list.
interface Props {
  stack: readonly string[];
}

const { stack } = Astro.props;
---

<div class="stack">
  <p class="stack__label" aria-hidden="true">Stack</p>
  <ul class="stack__list" aria-label="Stack">
    {
      stack.map((label) => (
        <li>
          <button
            type="button"
            class="bullet"
            data-track={trackKey(label)}
            data-label={label}
            aria-pressed="false"
            aria-describedby="track-hint"
            style={`--bullet: var(--track-${trackColour(label)})`}
          >
            <span class="bullet__dot" aria-hidden="true" />
            {label}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .stack__label {
    font-size: 0.8125rem;
    font-weight: 800;
    font-stretch: 75%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stack__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .bullet {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 4px 13px 4px 5px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--ground);
    font-size: 0.9375rem;
    font-weight: 750;
    font-stretch: 87.5%;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }

  .bullet__dot {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--bullet);
    box-shadow: inset 0 0 0 2px var(--ink);
    transition: scale 0.3s var(--ease-out);
  }

  .bullet:hover {
    background: #fff;
  }

  .bullet:hover .bullet__dot {
    scale: 1.12;
  }

  .bullet[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .bullet[aria-pressed='true'] .bullet__dot {
    box-shadow: inset 0 0 0 2px var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .bullet,
    .bullet__dot {
      transition: none;
    }

    .bullet:hover .bullet__dot {
      scale: none;
    }
  }
</style>
