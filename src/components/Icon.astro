---
// Wayfinding pictograms, drawn on one 24px grid with one stroke weight.
interface Props {
  name: 'mail' | 'exit' | 'download' | 'back';
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'mail' && <><rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="m3.5 7 8.5 6 8.5-6" /></>}
  {name === 'exit' && <><path d="M7 17 17 7" /><path d="M8.5 7H17v8.5" /></>}
  {name === 'download' && <><path d="M12 4v11" /><path d="m6.5 10 5.5 5.5 5.5-5.5" /><path d="M5 20h14" /></>}
  {name === 'back' && <><path d="M19 12H5" /><path d="m11 6-6 6 6 6" /></>}
</svg>
