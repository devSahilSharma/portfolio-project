---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

if (!Astro.site) throw new Error('Set `site` in astro.config.mjs: canonical and sharing URLs need it');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Rendered from scripts/og/og.html (npm run og). Crawlers need an absolute URL.
const previewImage = new URL('/og.png', Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#141414" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="strip">
      <Nav />
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/line';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    z-index: 50;
    top: 12px;
    left: 12px;
    padding: 0.7em 1.1em;
    border-radius: var(--tile-radius);
    background: var(--track-yellow);
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
    translate: 0 calc(-100% - 24px);
  }

  .skip:focus-visible {
    translate: none;
  }

  .strip {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--ink);
    color: var(--paper);
  }
</style>
